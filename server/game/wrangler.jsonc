// The Kasala game server: rooms, matchmaking and every match. Deploy from this folder.
{
  "name": "kasala-game",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "Room" }, { "name": "MM", "class_name": "Matchmaker" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] } ]
}
